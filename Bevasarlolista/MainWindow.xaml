<Window x:Class="Bevasarlolista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bevasarlolista"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200px"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" x:Name="listbox" KeyDown="listbox_KeyDown"></ListBox>
        <Button x:Name="btn_add" Content="Hozzáad" Grid.Column="1" Width="51.5" Height="20" HorizontalAlignment="Left" VerticalAlignment="top" Margin="8,60,0,0" Click="btn_add_Click"/>
        <Button x:Name="btn_del" Content="Törlés" Grid.Column="1" Width="51.5" Height="20" HorizontalAlignment="Left" VerticalAlignment="top" Margin="59.5,60,0,0" Click="btn_del_Click"/>
        <TextBox x:Name="textbox" Grid.Column="1" Width="100" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,30,0,0" KeyDown="textbox_KeyDown"/>
        <Button Grid.Column="1" Content="Törlés mind" HorizontalAlignment="Left" Margin="10,85,0,0" VerticalAlignment="Top" Height="20" Width="99" Click="Button_Click"/>
    </Grid>
</Window>
